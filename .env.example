# Copy to .env and fill in your own values. Never commit the real .env.

# Portkey (default route for AI calls)
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# OpenAI via Portkey: any model in the 5.6 or 6 series
OPENAI_MODEL=gpt-6-luna

# Optional direct routes
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Which route to use first: portkey | openai | anthropic
AI_PROVIDER=portkey

# Local data (not committed)
DATABASE_PATH=data/campus_customs.db
PRODUCT_IMAGES_DIR=data/products
